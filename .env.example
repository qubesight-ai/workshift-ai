# Node 22.13+; no se cargan credenciales automáticamente.
WORLD_SQLITE_PATH=./data/world.sqlite
WORLD_TRACE_PATH=./data/traces.jsonl
# Proveedor principal; sin fallback a proveedores externos.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=workshift-ai
METERLESS_SCOPE=user
# REST directa de Zetaris, no el proxy web :3000.
ZETARIS_BASE_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Dashboard / Groq (server-only)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
# For the existing real sample override WORLD_SQLITE_PATH above:
# WORLD_SQLITE_PATH=./artifacts/real-demo/world.sqlite

# Nightshift dashboard provider (server-only)
# AI_PROVIDER=nightshift
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_BASE_URL=http://127.0.0.1:18088/v1
NIGHTSHIFT_MODEL=meterless/text

# Dedicated H-MEM reference persistence (state.json and ledger.jsonl per occupation).
HMEM_ARTIFACTS_DIR=./artifacts/hmem
